# Puerto del servidor NestJS
PORT=3000
NODE_ENV=development

# Conexión a Neon Tech PostgreSQL (PostGIS)
# Reemplazar con la URL proporcionada en la consola de Neon Tech:
# Formato: postgresql://[usuario]:[password]@[endpoint-neon].tech/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# Parámetros Operativos SAME
RATE_PER_MINUTE_COP=500
MIN_BATTERY_START_PERCENT=20
NORMAL_SPEED_LIMIT=20
PEDESTRIAN_SPEED_LIMIT=10

# Autenticación JWT
JWT_SECRET=SAME_SECRET_KEY_MALECON_BARRANQUILLA_2026
JWT_EXPIRES_IN=7d
