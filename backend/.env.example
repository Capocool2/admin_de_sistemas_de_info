# Puerto del servidor NestJS
PORT=3000
NODE_ENV=development

# Conexión a Neon Tech PostgreSQL (PostGIS)
DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# Parámetros Operativos SAME
RATE_PER_MINUTE_COP=500
MIN_BATTERY_START_PERCENT=20
NORMAL_SPEED_LIMIT=20
PEDESTRIAN_SPEED_LIMIT=10

# Autenticación JWT
JWT_SECRET=SAME_SECRET_KEY_MALECON_BARRANQUILLA_2026
JWT_EXPIRES_IN=7d

# Configuración de Correo Electrónico (Nodemailer)
# Compatible con Gmail App Password. Si se dejan vacíos, se activa el fallback
# automático en consola para no bloquear pruebas locales de desarrollo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAME Malecón" <no-reply@same.com>
